{
  "name": "dojofoo",
  "version": "0.4.0",
  "description": "Installable coding dojos that turn your AI agent into a sensei.",
  "keywords": [
    "cli",
    "dojo",
    "kata",
    "ai-agent",
    "claude",
    "claude-code",
    "coding-practice",
    "pair-programming"
  ],
  "license": "FSL-1.1-ALv2",
  "author": "Tomas Sivicki <tomas.sivicki@gmail.com>",
  "homepage": "https://dojo.foo",
  "bugs": {
    "url": "https://github.com/dojofoo/dojofoo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dojofoo/dojofoo.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "directory": ".package"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dojofoo": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @dojofoo/ui build && tsup && node scripts/bundle-ui.mjs",
    "test": "vitest run",
    "test:package": "node scripts/test-packed-ui.mjs",
    "test:watch": "vitest",
    "types:check": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@dojofoo/agents": "workspace:*",
    "@dojofoo/config": "workspace:*",
    "giget": "^3.3.1",
    "jiti": "^2.7.0",
    "just-bash": "3.6.0",
    "portless": "0.15.12",
    "typescript": "6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dojofoo/protocol": "workspace:*",
    "@dojofoo/ui": "workspace:*",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
