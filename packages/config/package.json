{
  "name": "@dojofoo/config",
  "version": "0.3.3",
  "private": true,
  "description": "Shared configuration and Vitest integration for dojofoo.",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://dojo.foo/docs",
  "bugs": {
    "url": "https://github.com/dojofoo/dojofoo/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dojofoo/dojofoo",
    "directory": "packages/config"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "exports": {
    "./templates/*": "./templates/*",
    "./chapters": { "types": "./dist/chapters.d.ts", "import": "./dist/chapters.js" },
    "./course-installations": {
      "import": "./dist/course-installations.js",
      "types": "./dist/course-installations.d.ts"
    },
    "./agents": {
      "import": "./dist/agents.js",
      "types": "./dist/agents.d.ts"
    },
    "./agent-installations": {
      "import": "./dist/agent-installations.js",
      "types": "./dist/agent-installations.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    },
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vitest": {
      "import": "./dist/vitest.js",
      "types": "./dist/vitest.d.ts"
    },
    "./local-state": {
      "import": "./dist/local-state.js",
      "types": "./dist/local-state.d.ts"
    },
    "./project-preparation": {
      "import": "./dist/project-preparation.js",
      "types": "./dist/project-preparation.d.ts"
    }
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@dojofoo/protocol": "workspace:*",
    "globby": "16.2.4",
    "jiti": "^2.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
