{
  "name": "@dojofoo/config",
  "version": "0.0.7",
  "description": "Shared configuration and Vitest integration for dojofoo.",
  "license": "MIT",
  "homepage": "https://dojo.foo/docs",
  "bugs": {
    "url": "https://github.com/dojofoo/dojofoo/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dojofoo/dojofoo",
    "directory": "packages/config"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vitest": {
      "import": "./dist/vitest.js",
      "types": "./dist/vitest.d.ts"
    }
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.0.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
