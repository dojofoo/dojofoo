    "./hooks/*": "./src/hooks/*",
    "./*": "./src/components/ui/*.tsx"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "storybook": "storybook dev -p 6006",
