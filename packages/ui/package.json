{
  "name": "@dojofoo/ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Shared Dojofoo UI components, local learning interface, and agent-facing server.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./elements/*": "./src/components/elements/*.tsx",
    "./react-bits/*": "./src/components/react-bits/*.tsx",
    "./premium/empty-states/*": "./src/components/premium/empty-states/*.tsx",
