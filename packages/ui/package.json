    "./premium/hero-sections/*": "./src/components/premium/hero-sections/*.tsx",
    "./premium/integrations/*": "./src/components/premium/integrations/*.tsx",
    "./premium/logo-cloud/*": "./src/components/premium/logo-cloud/*.tsx",
    "./lib/*": "./src/lib/*",
    "./hooks/*": "./src/hooks/*",
    "./*": "./src/components/ui/*.tsx"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o ../../.storybook-static/ui",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:editor": "playwright test --config playwright.editor.config.ts",
    "types:check": "tsc --noEmit"
  },
