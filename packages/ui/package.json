{
  "name": "@dojofoo/ui",
  "version": "0.0.5",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "description": "Shared Dojofoo UI components, local learning interface, and agent-facing server.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./view-transitions.css": "./src/view-transitions.css",
    "./api-reference.css": "./src/api-reference.css",
    "./elements/*": "./src/components/elements/*.tsx",
    "./react-bits/*": "./src/components/react-bits/*.tsx",
    "./premium/empty-states/*": "./src/components/premium/empty-states/*.tsx",
    "./premium/feature-sections/*": "./src/components/premium/feature-sections/*.tsx",
    "./premium/hero-sections/*": "./src/components/premium/hero-sections/*.tsx",
    "./premium/integrations/*": "./src/components/premium/integrations/*.tsx",
    "./premium/logo-cloud/*": "./src/components/premium/logo-cloud/*.tsx",
    "./lib/view-transition": "./src/lib/view-transition.ts",
    "./lib/*": "./src/lib/*",
    "./hooks/*": "./src/hooks/*",
    "./*": "./src/components/ui/*.tsx"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node ../uix/scripts/build-course-slides.mjs && vite build",
    "start": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o node_modules/.cache/storybook-static",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:library": "playwright test --config playwright.library.config.ts",
    "test:lesson": "node scripts/verify-lesson-runtime.mjs",
    "test:interactive": "node scripts/verify-interactive-runtime.mjs",
    "test:evaluation": "node scripts/verify-evaluation-runtime.mjs",
    "test:editor": "playwright test --config playwright.editor.config.ts",
    "types:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^3.0.3",
