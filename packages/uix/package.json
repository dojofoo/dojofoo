    "motion": "^14.9.0",
    "radix-ui": "^1.8.1",
    "shaka-player": "^5.3.3",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "2.9.1",
    "youtube-video-element": "1.9.1"
