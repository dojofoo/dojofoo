{
  "name": "@dojofoo/uix",
  "version": "0.2.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./hooks/*": "./src/hooks/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./components/context-menu": "./src/components/context-menu.tsx",
    "./styles.css": "./src/styles.css",
    "./styles/slides.css": "./src/styles/slides.css",
    "./styles/view-transitions.css": "./src/styles/view-transitions.css",
    "./styles/api-reference.css": "./src/styles/api-reference.css",
    "./containers/*": "./src/containers/*.tsx",
    "./pages/*": "./src/pages/*.tsx",
    "./monaco-assets": "./monaco-assets.ts",
    "./archive/motion/button/*": "./src/archive/motion/button/*.tsx",
    "./components/motion/file-tree": "./src/components/motion/file-tree.tsx",
    "./components/motion/shared-layout-bg": "./src/components/motion/shared-layout-bg.tsx",
    "./archive/motion/input": "./src/archive/motion/input.tsx",
    "./archive/affectui/*": "./src/archive/affectui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./provider": "./src/provider.tsx",
    "./icons": "./src/lib/icons.tsx",
    "./fonts.css": "./src/fonts.css",
    "./assets/*": "./src/assets/*",
    "./web/site": "./src/web/site.tsx",
    "./web/landing": "./src/web/landing.tsx",
    "./web/learning-preview": "./src/web/learning-preview.tsx",
    "./web/learning-illustration": "./src/web/learning-illustration.tsx",
    "./web/courses": "./src/web/courses.tsx",
    "./web/pricing": "./src/web/pricing.tsx",
    "./web/course": "./src/web/course.tsx",
    "./web/catalog": "./src/web/catalog.ts",
    "./web/seo": "./src/web/seo.ts",
    "./web/compare": "./src/web/compare.tsx",
    "./docs/layout": "./src/docs/docs-site.tsx",
    "./docs/content": "./src/docs/content.ts",
    "./web/styles.css": "./src/web/styles.css"
  },
  "scripts": {
    "ui:add": "pnpm dlx varlock@latest run --inject vars -- pnpm dlx shadcn@latest add",
    "slides:build": "cd fixtures && slidev build slides.md --base /slides/ --out ../public/slides --without-notes",
    "storybook": "pnpm slides:build && portless ui.dojofoo storybook dev",
    "storybook:web": "pnpm slides:build && UIX_STORIES=web portless uix.dojofoo storybook dev",
    "storybook:direct": "pnpm slides:build && storybook dev -p 6007",
    "storybook:build": "pnpm slides:build && storybook build -o node_modules/.cache/storybook-static",
    "types:check": "tsc --noEmit",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "theme:add": "node scripts/theme-add.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
