{
  "name": "@dojofoo/uix",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./components/context-menu": "./src/components/context-menu.tsx",
    "./styles.css": "./src/styles.css",
    "./containers/*": "./src/containers/*.tsx",
    "./pages/*": "./src/pages/*.tsx",
    "./monaco-assets": "./monaco-assets.ts",
    "./archive/motion/button/*": "./src/archive/motion/button/*.tsx",
    "./components/motion/file-tree": "./src/components/motion/file-tree.tsx",
    "./components/motion/shared-layout-bg": "./src/components/motion/shared-layout-bg.tsx",
    "./archive/motion/input": "./src/archive/motion/input.tsx",
    "./archive/affectui/*": "./src/archive/affectui/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "slides:build": "cd fixtures && slidev build slides.md --base /slides/ --out ../public/slides --without-notes",
    "storybook": "pnpm slides:build && portless ui.dojofoo storybook dev",
    "storybook:direct": "pnpm slides:build && storybook dev -p 6007",
    "storybook:build": "pnpm slides:build && storybook build -o ../../.storybook-static/uix",
    "types:check": "tsc --noEmit",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "theme:add": "node scripts/theme-add.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@fontsource/iosevka": "5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@iconify-json/fluent": "1.2.59",
    "@iconify-json/solar": "1.2.13",
    "@mingcute/react": "3.0.2",
    "@mynaui/icons-react": "^0.4.11",
    "@toolwind/corner-shape": "0.0.8-3",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "cuelume": "^0.2.2",
    "iconoir-react": "7.12.1",
    "lucide-react": "^1.52.0",
    "motion": "^13.1.1",
    "modern-monaco": "0.4.2",
    "markdown-exit": "^1.3.0",
    "shiki": "^4.4.3",
    "radix-ui": "^1.6.7",
    "shaka-player": "^5.3.0",
    "tailwind-merge": "^3.6.0",
    "youtube-video-element": "1.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "@slidev/types": "53.0.0",
    "markdown-it": "14.3.3",
    "@playwright/test": "^1.64.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "tm-grammars": "1.32.22",
    "vitest": "^5.0.5",
    "portless": "^0.15.8",
    "shadcn": "^4.22.1",
    "storybook": "10.6.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4"
  }
}
