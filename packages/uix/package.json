    "@radix-ui/react-presence": "^1.1.11",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@toolwind/corner-shape": "0.0.8-3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "cuelume": "^0.2.8",
    "dither-plugin": "^1.1.1",
    "fumadocs-core": "16.17.9",
    "fumadocs-openapi": "12.5.7",
    "fumadocs-ui": "16.17.9",
    "iconoir-react": "7.12.1",
    "lucide-react": "^1.65.0",
