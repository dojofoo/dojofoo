    "@playwright/test": "^1.64.1",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "@slidev/types": "53.0.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai-client": "1.0.1",
