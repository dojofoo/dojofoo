# The fast checks CI runs on a pull request (scripts/check.mjs); turbo skips the build when nothing changed.
# Git hands a hook GIT_DIR: without unsetting it, a test's `git init` of a temporary course reinitialises this repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
pnpm build:check --output-logs=errors-only && pnpm check
