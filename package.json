{
  "name": "@dojofoo/workspace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "assets:logo": "node scripts/assets/build-logo.mjs",
    "build": "turbo build",
    "ui": "pnpm --filter dojofoo exec node dist/index.js ui",
    "ui:build": "pnpm --filter dojofoo build",
    "containers:prune": "node scripts/vercel/prune-container-images.mjs",
    "e2e:up": "docker compose up -d --wait --build",
    "e2e:down": "docker compose down -v --remove-orphans",
    "e2e:logs": "docker compose logs -f dojocho-e2e",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs packages",
    "lint:names": "git grep -n -P '@dojofoo/(agent(?![s-])|agent-api|authoring)\\b|packages/(agent|agent-api|authoring)\\b' -- . ':!.changeset/' ':!**/CHANGELOG.md' ':!docs/architecture/' ':!docs/designs/' ':!docs/research/' ':!.prd/'; test $? -eq 1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@ai-sdk/harness-opencode@1.0.173": "patches/@ai-sdk__harness-opencode@1.0.173.patch",
      "nitro@3.0.260903-beta": "patches/nitro@3.0.260903-beta.patch",
      "@ai-sdk/harness-fx@1.0.86": "patches/@ai-sdk__harness-fx@1.0.86.patch",
      "@ai-sdk/harness-acp@1.0.110": "patches/@ai-sdk__harness-acp@1.0.110.patch"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "dependency-cruiser": "18.7.2",
    "turbo": "^2.11.9",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "youch": "^4.1.1"
  }
}
