{
  "name": "@dojofoo/web",
  "version": "0.0.7",
  "type": "module",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "sideEffects": false,
  "scripts": {
    "assets:favicons": "node scripts/favicons.mjs",
    "assets:learning": "node scripts/capture-learning-artwork.mjs",
    "predev": "rm -rf .tanstack",
    "dev": "portless dojofoo vite dev",
    "docs:generate": "bun scripts/generate-api-docs.ts",
    "docs:check": "bun scripts/generate-api-docs.ts --check",
    "build": "pnpm --filter @dojofoo/api openapi:generate && vite build && node scripts/verify-static-build.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:production": "DOJO_WEB_TEST_PREVIEW=1 playwright test e2e/landing-performance.spec.ts",
    "types:check": "fumadocs-mdx && node scripts/generate-routes.mjs && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@dojofoo/ui": "workspace:*",
    "@dojofoo/uix": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/hind": "5.3.0",
    "@fontsource/iosevka": "5.3.0",
    "@fontsource/khand": "5.3.0",
    "@fuma-translate/react": "^1.0.2",
    "@mynaui/icons-react": "^0.4.11",
    "@radix-ui/react-slot": "^1.5.0",
    "@takumi-rs/core": "^2.19.0",
    "@takumi-rs/core-darwin-arm64": "^2.19.0",
    "@takumi-rs/core-linux-arm64-gnu": "^2.19.0",
    "@takumi-rs/core-linux-x64-gnu": "^2.19.0",
    "@takumi-rs/image-response": "^2.19.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/start-static-server-functions": "1.167.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "fumadocs-core": "16.18.1",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-openapi": "12.6.0",
    "fumadocs-ui": "16.18.1",
    "metal-fx": "^2.0.11",
    "motion": "^14.10.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "takumi-js": "^2.19.0",
    "tslib": "^2.9.1",
    "vgpu": "0.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-generator": "1.167.40",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "nitro": "3.0.260903-beta",
    "playwright": "^1.64.1",
    "portless": "^0.16.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "youch": "^4.1.1"
  }
}
