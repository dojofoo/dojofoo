{
  "name": "@dojofoo/api",
  "version": "0.0.2",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "openapi:generate": "bun scripts/generate-openapi.ts && pnpm --filter @dojofoo/web docs:generate",
    "openapi:check": "bun scripts/generate-openapi.ts --check && pnpm --filter @dojofoo/web docs:check",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/openapi": "1.4.16",
    "@libsql/client": "0.17.4",
    "drizzle-orm": "0.45.2",
    "elysia": "^1.4.18",
    "exact-mirror": "0.2.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "msw": "^3.0.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
